## Шаблон локальной конфигурации
##
## 1. Скопируйте этот файл в .env
## 2. Редактируйте только .env
## 3. После изменений выполните: dart run build_runner build -d
##
## Любые конфиденциальные значения храните только в локальном .env.

APP_ENV=development
ENABLE_DEV_TOOLS=false
SENTRY_DSN=

## Aegis server used by the current test environment.
AEGIS_HOST=
AEGIS_PORT=8888
AEGIS_CONNECT_TIMEOUT_SECONDS=10
## Leave empty unless the server explicitly enables Server:EnableTransportMasking.
AEGIS_TRANSPORT_MASKING_KEY=
AEGIS_USE_TLS=false
## Optional: explicit Bot API base URL for TOTP setup/enable/disable.
## If empty, the client derives it from AEGIS_HOST + port 5000 + current TLS mode.
AEGIS_BOT_API_BASE_URL=

## Optional: override built-in Aegis app credentials for custom/private servers.
AEGIS_APP_ID=
AEGIS_APP_HASH=
